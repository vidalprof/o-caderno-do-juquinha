  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1pdd963",
  "texto": "Comigo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1vnxi9p",
  "texto": "Embora.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_11ay2ng",
  "texto": "Depressa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_lt9j2i",
  "texto": "Aonde.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1ecmfe7",
  "texto": "Qual palavra falta aqui? O — nada no oceano.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_112y9qs",
  "texto": "Qual palavra falta aqui? A — vive na floresta.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_191eus3",
  "texto": "Qual palavra falta aqui? O — corre solto na fazenda.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_sts0re",
  "texto": "Qual palavra falta aqui? A — anda devagar na areia.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_dldwf1",
  "texto": "Qual palavra falta aqui? O — é o rei da selva.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_fkggfn",
  "texto": "Qual palavra falta aqui? O — passou muito rápido pela rua.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_19d99z7",
  "texto": "Anda devagar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_kf7xai",
  "texto": "Bota ovo no ninho.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_17yb06o",
  "texto": "Cava buraco no chão.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1bgwi24",
  "texto": "Subiu pela parede.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_cnj52o",
  "texto": "Pousou na flor.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1vcpw9f",
  "texto": "É muito grande.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1szqnur",
  "texto": "Toque numa figura do lado esquerdo e depois na frase do lado direito.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_s2vk4b",
  "texto": "Eu vou embora agora.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1yo969u",
  "texto": "O gato dorme embaixo da mesa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1ho0mv5",
  "texto": "Venha comigo também.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_4vurzu",
  "texto": "Talvez eu chegue amanhã.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_x50np1",
  "texto": "Corra depressa para a escola.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1feni29",
  "texto": "A tartaruga anda de vagar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "jq_1kdc6oy",
  "texto": "Ogatodormeembaixodamesa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
